# @devopscoop/eat-the-pii is installed from its git URL (package.json) until it is published to npm.
# npm 12 refuses git dependencies by default; "root" allows them only when package.json lists them directly.
# That covers npm ci, but changing the git dependency to a new tag needs a one-off --allow-git=all, e.g.
#   npm install --save-exact --allow-git=all "git+https://gitlab.com/devopscoop/eat-the-pii.git#v0.2.0"
allow-git=root
